# Pick ONE block. The default is NVIDIA's free GLM-5.3-Flash.
LLM_PROVIDER=openai_style
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=z-ai/glm-5.3-flash
LLM_API_KEY=            # free key: build.nvidia.com → GLM-5.3-Flash → Get API Key

# Backup on the same NVIDIA key:  LLM_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# Groq free plan:   LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=qwen/qwen3.8-27b
# Z.ai free:        LLM_BASE_URL=https://api.z.ai/api/paas/v4     LLM_MODEL=glm-4.6v-flash
# OpenRouter free:  LLM_BASE_URL=https://openrouter.ai/api/v1     LLM_MODEL=nvidia/nemotron-3.5-super-vl:free
# Ollama on this Mac (start with OLLAMA_CONTEXT_LENGTH=32768 ollama serve):
#                   LLM_BASE_URL=http://localhost:11434/v1        LLM_MODEL=qwen3.5:9b
# Claude (paid):    LLM_PROVIDER=claude  LLM_MODEL=claude-opus-5-5  ALLOW_PAID_MODELS=true  LLM_EFFORT=medium
#                   (LLM_API_KEY or ANTHROPIC_API_KEY). Faster options: claude-sonnet-5-5, claude-haiku-5-5

LLM_IMAGES=auto          # send screenshots when the AI asks for them: auto | yes | no
ALLOW_PAID_MODELS=false  # paid AIs never run unless this is true
PORT=8000
