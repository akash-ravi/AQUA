ANTHROPIC_API_KEY=            # or leave empty and run `ant auth login`
JARVIS_MODEL=claude-opus-5-5  # faster: claude-sonnet-5-5, claude-haiku-5-5
JARVIS_EFFORT=low             # low | medium | high | xhigh | max
JARVIS_PORT=8000
TYPESAFE_API_KEY=              # optional: Jev for approval replies and speech screening
ELEVENLABS_API_KEY=            # speech in and out on the phone (Scribe v2 Realtime, Flash v2.5)
JARVIS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb  # any ElevenLabs default voice; cloned voices start slower
